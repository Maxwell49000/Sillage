# PostgreSQL (docker-compose et backend)
DATABASE_NAME=chatspringai
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5433/chatspringai

# Ports exposés par Docker Compose
FRONTEND_PORT=8000
BACKEND_PORT=8080
DATABASE_PORT=5433

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Origines supplémentaires pour un frontend lancé hors du reverse proxy
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Frontend — laisser vide en développement pour utiliser le proxy Vite
VITE_API_URL=
